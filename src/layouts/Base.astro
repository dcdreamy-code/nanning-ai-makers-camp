---
import '../styles/global.css';
import { site } from '../data/content.js';

interface Props {
  title?: string;
  desc?: string;
}
const { title = site.title, desc = site.description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-locale="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="keywords" content={site.keywords} />
    <meta name="author" content={site.brand} />
    <link rel="canonical" href={site.url} />
    <meta name="theme-color" content="#15171c" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={site.url} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // 在首帧前打标，避免 reveal 动画闪烁
      document.documentElement.classList.add('js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
        setTimeout(function () {
          if (!window.__abl) document.documentElement.classList.remove('js-motion');
        }, 3500);
      }
    </script>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Course',
        name: site.brand,
        alternateName: site.brandEn,
        description: desc,
        inLanguage: 'zh-CN',
        url: site.url,
        educationalLevel: 'Ages 10–18',
        provider: {
          '@type': 'Organization',
          name: site.byline.replace(' 出品', ''),
          url: site.url,
          email: site.email,
          telephone: site.phone
        },
        offers: {
          '@type': 'Offer',
          price: '6800',
          priceCurrency: 'CNY',
          availability: 'https://schema.org/LimitedAvailability',
          category: 'Paid'
        },
        hasCourseInstance: {
          '@type': 'CourseInstance',
          courseMode: 'online',
          startDate: '2026-11-07T19:30:00+08:00',
          courseSchedule: {
            '@type': 'Schedule',
            repeatFrequency: 'P1W',
            repeatCount: 8,
            byDay: 'https://schema.org/Saturday'
          },
          maximumAttendeeCapacity: 6
        }
      })}
    />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
