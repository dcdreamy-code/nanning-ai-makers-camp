---
import { curriculum as C } from '../data/content.js';
import { nnWeek1Tags, nnWeek3Quotes } from '../data/nanning.js';
import Title from './Title.astro';

// 把南宁本地化的选题/访谈注入课程数据
const weeks = C.weeks.map((w) => {
  if (w.no === '01') return { ...w, tags: nnWeek1Tags };
  if (w.no === '03') return { ...w, quotes: nnWeek3Quotes };
  return w;
});
---

<section class="section section--ink curriculum" id="curriculum">
  <div class="curriculum__head wrap">
    <p class="eyebrow rv"><b>{C.num}</b> {C.label}</p>
    <h2 class="h2 curriculum__title rv rv-d1">
      <Title parts={C.title} />
    </h2>
    <div class="curriculum__aside rv rv-d2">
      <p class="lead curriculum__desc">{C.desc}</p>
      <div class="curriculum__sample">
        <p class="label">{C.sampleLead}</p>
        <p class="curriculum__sample-title">{C.sampleTitle}</p>
        <p class="label">{C.sampleNote}</p>
      </div>
    </div>
  </div>

  <!-- 课程卡横滑轨道 -->
  <div class="stack" data-stack tabindex="0" aria-label="8 周课程卡片，可横向滚动">
    <p class="stack__label label">Week</p>
    {weeks.map((w, i) => (
      <article class={`week week--${w.kind}`} data-week={w.no} data-week-card={i}>
        <header class="week__head">
          <span class="week__no num">{w.no}</span>
          <span class="week__goal">{w.goal}</span>
        </header>
        <h3 class="week__en">{w.en}</h3>
        {w.sub && <p class="week__sub">{w.sub}</p>}
        <p class="week__desc">{w.desc}</p>

        <div class="week__viz">
          {w.kind === 'tags' && (
            <ul class="viz-tags">
              {w.tags.map((t) => <li>{t}</li>)}
            </ul>
          )}

          {w.kind === 'sentence' && (
            <p class="viz-sentence">
              {w.parts.map((p) => p.em ? <em>{p.t}</em> : p.t)}
            </p>
          )}

          {w.kind === 'quotes' && (
            <div class="viz-quotes">
              <div class="viz-quotes__bar">
                <span>{w.progress}</span>
                <i><b style={`width:${(Number(w.progress.match(/\d+/)[0]) / 5) * 100}%`}></b></i>
              </div>
              {w.quotes.map((q) => (
                <figure class="qcard">
                  <figcaption>{q.who}</figcaption>
                  <blockquote>{q.text}</blockquote>
                </figure>
              ))}
            </div>
          )}

          {w.kind === 'flow' && (
            <ol class="viz-flow">
              {w.flow.map((f, k) => (
                <li>
                  <span class="viz-flow__k">{f.k}</span>
                  <span class="viz-flow__v">{f.v}</span>
                  {k < w.flow.length - 1 && <i class="viz-flow__arr" aria-hidden="true"></i>}
                </li>
              ))}
            </ol>
          )}

          {w.kind === 'metrics' && (
            <div class="viz-metrics">
              <dl>
                {w.metrics.map((m) => (
                  <div class="metric">
                    <dt>{m.k}</dt>
                    <dd>{m.v}</dd>
                  </div>
                ))}
              </dl>
              <p class="viz-metrics__note">{w.note}</p>
            </div>
          )}

          {w.kind === 'diff' && (
            <div class="viz-diff">
              <div class="diff">
                <span class="diff__tag">{w.left.tag}</span>
                <ul>{w.left.items.map((it) => <li class="is-del">{it}</li>)}</ul>
              </div>
              <span class="diff__arr" aria-hidden="true">→</span>
              <div class="diff diff--add">
                <span class="diff__tag">{w.right.tag}</span>
                <ul>{w.right.items.map((it) => <li class="is-add">{it}</li>)}</ul>
              </div>
              <p class="viz-diff__note">{w.diffNote}</p>
            </div>
          )}

          {w.kind === 'demo' && (
            <div class="viz-demo">
              <p class="viz-demo__title">{w.title}</p>
              <ul class="viz-demo__pills">
                {w.pills.map((p) => <li>{p}</li>)}
              </ul>
              <p class="viz-demo__dots" aria-hidden="true">
                {Array.from({ length: w.dots }).map(() => <i></i>)}
              </p>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>

  <div class="stack__progress wrap" aria-hidden="true">
    <p class="label" data-week-current>01 / 08</p>
    <i><b data-stack-bar></b></i>
  </div>
</section>

<style>
  .curriculum {
    overflow: hidden;
    /* 底部不留大片空白：进度条之后直接收尾 */
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .curriculum__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 24px;
    align-items: start;
  }
  .curriculum__head .eyebrow {
    grid-column: 1 / span 3;
    padding-top: 12px;
  }
  .curriculum__title {
    grid-column: 4 / span 5;
  }
  .curriculum__aside {
    grid-column: 9 / -1;
    padding-top: 10px;
    display: grid;
    gap: 26px;
  }
  .curriculum__desc {
    font-size: 14px;
    line-height: 1.8;
    color: rgba(244, 241, 234, 0.72);
  }
  .curriculum__sample {
    padding-left: 16px;
    border-left: 1px solid var(--signal);
    display: grid;
    gap: 6px;
  }
  .curriculum__sample-title {
    font-family: var(--serif);
    font-size: 17px;
    color: var(--paper);
  }

  /* ---------- 横滑轨道 ----------
     关键：.stack 必须在 section（block容器）里做 overflow-x，
     不能是 .wrap 的 flex 子项，否则 width:max-content 会被压成容器宽。
     所以这里用 margin 负值出血到屏幕两侧，再自行居中 padding。 */
  .stack {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 20px;
    width: 100%;
    margin-top: clamp(56px, 7vw, 96px);
    padding-inline: max(var(--gutter), (100vw - var(--max)) / 2);
    padding-bottom: 28px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .stack::-webkit-scrollbar {
    display: none;
  }
  .stack__label {
    position: absolute;
    left: max(var(--gutter), (100vw - var(--max)) / 2);
    top: -16px;
  }

  .week {
    display: flex;
    flex-direction: column;
    /* flex:none 关键 —— 否则卡片会被压扁，横向轨道失效 */
    flex: none;
    width: clamp(300px, 26vw, 348px);
    min-height: 480px;
    padding: 24px;
    scroll-snap-align: center;
    border: 1px solid var(--line-inv);
    border-radius: 16px;
    background: rgba(244, 241, 234, 0.045);
    transition: border-color 0.5s var(--ease-out), background 0.5s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  .week:hover {
    background: rgba(244, 241, 234, 0.07);
    border-color: rgba(244, 241, 234, 0.26);
  }
  /* 当前聚焦卡片高亮 */
  .week.is-current {
    border-color: var(--signal);
    background: rgba(232, 86, 42, 0.07);
  }

  .week__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .week__no {
    color: var(--paper);
    font-size: clamp(34px, 3.4vw, 46px);
  }
  .week.is-current .week__no {
    color: var(--signal);
  }
  .week__goal {
    font-size: 12px;
    text-align: right;
    color: var(--signal);
    letter-spacing: 0.02em;
  }
  .week__en {
    margin-top: 18px;
    font-family: var(--display);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.28;
    color: var(--paper);
  }
  .week__sub {
    margin-top: 4px;
    font-size: 12px;
    color: rgba(244, 241, 234, 0.44);
  }
  .week__desc {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.78;
    color: rgba(244, 241, 234, 0.66);
  }

  /* 卡片内可视区：底部对齐，形成整齐基线 */
  .week__viz {
    display: flex;
    align-items: flex-end;
    flex: 1;
    margin-top: 20px;
  }
  .week__viz > * {
    width: 100%;
  }

  /* tags */
  .viz-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .viz-tags li {
    padding: 7px 13px;
    border: 1px solid var(--line-inv);
    border-radius: 999px;
    font-size: 12.5px;
    color: rgba(244, 241, 234, 0.8);
  }

  /* sentence */
  .viz-sentence {
    padding: 18px;
    border-radius: 12px;
    background: rgba(244, 241, 234, 0.05);
    font-size: 13.5px;
    line-height: 1.9;
    color: rgba(244, 241, 234, 0.72);
  }
  .viz-sentence em {
    font-style: normal;
    color: var(--signal);
  }

  /* quotes */
  .viz-quotes {
    display: grid;
    gap: 8px;
  }
  .viz-quotes__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }
  .viz-quotes__bar i {
    flex: 1;
    height: 2px;
    background: rgba(244, 241, 234, 0.14);
    border-radius: 2px;
    overflow: hidden;
  }
  .viz-quotes__bar b {
    display: block;
    height: 100%;
    background: var(--signal);
  }
  .qcard {
    padding: 12px 14px;
    border-radius: 10px;
    background: rgba(244, 241, 234, 0.05);
  }
  .qcard figcaption {
    font-size: 11px;
    color: rgba(244, 241, 234, 0.46);
  }
  .qcard blockquote {
    margin-top: 5px;
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(244, 241, 234, 0.86);
  }

  /* flow */
  .viz-flow {
    display: grid;
    gap: 10px;
  }
  .viz-flow li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--line-inv);
  }
  .viz-flow__k {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--paper);
    min-width: 2.6em;
  }
  .viz-flow__v {
    font-size: 12.5px;
    color: rgba(244, 241, 234, 0.58);
  }
  .viz-flow__arr {
    position: absolute;
    left: 8px;
    bottom: -7px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--signal);
  }

  /* metrics */
  .viz-metrics {
    padding: 18px;
    border-radius: 12px;
    background: var(--paper);
    color: var(--ink);
  }
  .metric {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(21, 23, 28, 0.1);
    font-size: 12px;
  }
  .metric:last-child {
    border-bottom: 0;
  }
  .metric dd {
    margin: 0;
    font-family: var(--display);
    font-size: 17px;
    color: var(--signal);
  }
  .viz-metrics__note {
    margin-top: 8px;
    font-size: 11px;
    color: var(--muted);
  }

  /* diff */
  .viz-diff {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .diff {
    flex: 1;
    min-width: 118px;
    padding: 14px;
    border-radius: 10px;
    background: rgba(244, 241, 234, 0.05);
  }
  .diff--add {
    background: rgba(232, 86, 42, 0.1);
  }
  .diff__tag {
    display: block;
    font-family: var(--display);
    font-size: 15px;
    color: var(--paper);
    margin-bottom: 8px;
  }
  .diff--add .diff__tag {
    color: var(--signal);
  }
  .diff ul {
    display: grid;
    gap: 6px;
  }
  .diff li {
    padding: 5px 9px;
    border-radius: 6px;
    font-size: 11.5px;
  }
  .is-del {
    background: rgba(244, 241, 234, 0.07);
    color: rgba(244, 241, 234, 0.55);
    text-decoration: line-through;
    text-decoration-color: rgba(244, 241, 234, 0.35);
  }
  .is-add {
    background: rgba(232, 86, 42, 0.22);
    color: #ffbfa8;
  }
  .diff__arr {
    color: var(--signal);
    font-size: 16px;
  }
  .viz-diff__note {
    width: 100%;
    margin-top: 4px;
    font-size: 11px;
    color: rgba(244, 241, 234, 0.5);
  }

  /* demo */
  .viz-demo {
    padding: 20px 18px;
    border-radius: 12px;
    background: var(--paper);
    text-align: center;
  }
  .viz-demo__title {
    font-family: var(--display);
    font-size: 21px;
    color: var(--ink);
  }
  .viz-demo__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 7px;
    margin-top: 12px;
  }
  .viz-demo__pills li {
    padding: 5px 11px;
    border: 1px solid rgba(21, 23, 28, 0.16);
    border-radius: 999px;
    font-size: 11.5px;
    color: var(--text);
  }
  .viz-demo__dots {
    display: flex;
    justify-content: center;
    gap: 5px;
    margin-top: 14px;
  }
  .viz-demo__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
  }

  /* 进度条 */
  .stack__progress {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 22px;
  }
  .stack__progress i {
    flex: 1;
    height: 2px;
    background: var(--line-inv);
    border-radius: 2px;
    overflow: hidden;
  }
  .stack__progress b {
    display: block;
    height: 100%;
    width: 12.5%;
    background: var(--signal);
    transition: width 0.35s var(--ease-out);
  }

  @media (max-width: 1080px) {
    .curriculum__head .eyebrow,
    .curriculum__title,
    .curriculum__aside {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
</style>
