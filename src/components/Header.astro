---
import { site } from '../data/content.js';
---

<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a class="brand" href="/" aria-label={`${site.brand} 首页`}>
      <span class="brand__mark" aria-hidden="true"><i></i></span>
      <span class="brand__name">{site.brand}</span>
      <span class="brand__by">{site.byline}</span>
    </a>

    <nav class="site-nav" aria-label="页面导航">
      <ul>
        {site.nav.map((n) => <li><a href={`#${n.id}`}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="lang-switch" href="#enroll">报名</a>
      <a class="btn btn--sm" href="#enroll" data-magnetic>
        <span class="btn__fill" aria-hidden="true"></span>
        <span>预约名额</span>
        <span class="btn__icon">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 8h12M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr-only">菜单</span>
        <span class="menu-toggle__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="menu__nav wrap" aria-label="菜单">
      <ol>
        {site.nav.map((n, i) => (
          <li>
            <a href={`#${n.id}`} data-menu-link>
              <span class="menu__idx">{String(i + 1).padStart(2, '0')}</span>
              {n.label}
            </a>
          </li>
        ))}
      </ol>
      <div class="menu__foot">
        <a class="btn" href="#enroll" data-menu-link>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>预约名额</span>
          <span class="btn__icon">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M1.5 8h12M9 3.5 13.5 8 9 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
        <a class="menu__phone" href={`tel:${site.phone.replace(/[^0-9]/g, '')}`}>{site.phone}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 60;
    height: var(--header-h);
    color: var(--ink);
    transition: transform 0.6s var(--ease-out), color 0.4s ease;
  }
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(244, 241, 234, 0.82);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid rgba(21, 23, 28, 0.08);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .site-header.is-scrolled::before {
    opacity: 1;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  /* 位于深色区块上时反色 */
  .site-header.is-ink {
    color: var(--paper);
  }
  .site-header.is-ink::before {
    background: rgba(21, 23, 28, 0.78);
    border-bottom-color: rgba(244, 241, 234, 0.08);
  }
  .site-header.is-ink .btn--sm {
    --btn-bg: var(--paper);
    --btn-fg: var(--ink);
  }

  .site-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }
  .brand__mark {
    position: relative;
    display: block;
    width: 24px;
    height: 10px;
    align-self: center;
  }
  .brand__mark i {
    position: absolute;
    top: 50%;
    left: 0;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 50%;
    background: var(--signal);
  }
  .brand__mark::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 13px;
    width: 11px;
    height: 1px;
    margin-top: -0.5px;
    background: currentColor;
    opacity: 0.6;
  }
  .brand__name {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: currentColor;
  }
  .brand__by {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(14px, 2vw, 30px);
  }
  .site-nav a {
    position: relative;
    font-size: 14px;
    color: currentColor;
    opacity: 0.78;
    transition: opacity 0.3s;
  }
  .site-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }
  .site-nav a:hover {
    opacity: 1;
  }
  .site-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lang-switch {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 11px;
    opacity: 0.75;
    transition: opacity 0.3s, background 0.3s;
  }
  .lang-switch:hover {
    opacity: 1;
    background: rgba(21, 23, 28, 0.06);
  }
  .site-header.is-ink .lang-switch:hover {
    background: rgba(244, 241, 234, 0.12);
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    place-items: center;
  }
  .menu-toggle__bars {
    display: grid;
    gap: 6px;
    width: 20px;
  }
  .menu-toggle__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.45s var(--ease-out);
  }
  .menu-toggle[aria-expanded='true'] i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  /* 全屏菜单 */
  .menu {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    color: var(--paper);
    padding-top: calc(var(--header-h) + 32px);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease-out), visibility 0.5s;
  }
  .menu.is-open {
    opacity: 1;
    visibility: visible;
  }
  .menu__nav ol {
    display: grid;
    gap: 4px;
  }
  .menu__nav li a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-inv);
    font-family: var(--serif);
    font-size: 26px;
  }
  .menu__idx {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }
  .menu__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 36px;
    padding-bottom: 48px;
  }
  .menu__phone {
    font-family: var(--mono);
    font-size: 13px;
    opacity: 0.7;
  }

  @media (max-width: 1080px) {
    .site-nav,
    .lang-switch {
      display: none;
    }
    .site-header__actions {
      margin-left: auto;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .brand__by {
      display: none;
    }
  }
</style>
